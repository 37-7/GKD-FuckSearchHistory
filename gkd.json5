// GKD 搜索历史清理订阅
// 基于用户于 2026-08-27 提供的 52 份 GKD 快照编写。
// 说明：规则在对应“搜索页/历史记录页”出现时自动执行清理流程；不会从 APP 首页自动导航到搜索页。
// 夸克网盘因 WebView 未暴露可用无障碍节点，仅能使用坐标点击，故默认关闭。
{
  id: 82720261,
  name: 'GKD 搜索历史清理',
  version: 1,
  author: '37-7',
  updateUrl: 'https://raw.githubusercontent.com/37-7/GKD-FuckSearchHistory/main/gkd.json5',
  supportUri: 'https://github.com/37-7/GKD-FuckSearchHistory/issues',
  categories: [
    {
      key: 0,
      name: '功能类',
    },
  ],
  apps: [
    {
      id: 'com.xingin.xhs',
      name: '小红书',
      groups: [
        {
          key: 0,
          name: '功能类-自动清除搜索历史',
          desc: '进入搜索页后依次点击删除按钮、全部删除、确认。',
          matchRoot: true,
          activityIds: 'com.xingin.alioth.search.GlobalSearchActivity',
          rules: [
            {
              key: 0,
              name: '1.点击删除按钮',
              matches: '[text="历史记录"][visibleToUser=true] + ViewGroup > @ViewGroup[clickable=true][visibleToUser=true]',
            },
            {
              key: 1,
              preKeys: [0],
              name: '2.点击全部删除',
              matches: '@[clickable=true][visibleToUser=true] > [text="全部删除"][visibleToUser=true]',
            },
            {
              key: 2,
              preKeys: [1],
              name: '3.确认删除',
              matches: [
                '[text="删除全部搜索历史"][visibleToUser=true]',
                '[text="确认"][clickable=true][visibleToUser=true]',
              ],
            },
          ],
        },
      ],
    },
    {
      id: 'com.zhihu.hydrogen.x',
      name: 'Hydrogen',
      groups: [
        {
