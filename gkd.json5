              position: {
                x: 'screenWidth*0.925',
                y: 'screenHeight*0.206',
              },
            },
            {
              key: 1,
              preKeys: [0],
              name: '2.坐标点击清空',
              actionDelay: 500,
              actionMaximum: 1,
              resetMatch: 'activity',
              matches: '[parent=null][width=1200][height=2670]',
              position: {
                x: 'screenWidth*0.775',
                y: 'screenHeight*0.206',
              },
            },
            {
              key: 2,
              preKeys: [1],
              name: '3.坐标点击全部删除',
              actionDelay: 700,
              actionMaximum: 1,
              resetMatch: 'activity',
              matches: '[parent=null][width=1200][height=2670]',
              position: {
                x: 'screenWidth*0.72',
                y: 'screenHeight*0.925',
              },
            },
          ],
        },
